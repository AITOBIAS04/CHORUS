        "level": "h2"
      }
    },
    "impact_text": {
      "type": "Text",
      "props": {
        "text": "Push-recap reruns can once again detect substantive commits that arrive between scheduler dispatches, while quiet-day reruns are still correctly blocked."
      }
    },
