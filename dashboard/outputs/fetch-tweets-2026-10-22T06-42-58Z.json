{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "fetch-tweets",
        "description": "Social Monitor Dark"
      },
      "children": [
        "stack-main"
      ]
    },
    "stack-main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stat-days",
        "alert-main",
        "section-cause",
        "section-fix"
      ]
    },
    "stat-days": {
      "type": "Stat",
      "props": {
        "label": "Consecutive days with zero new mentions",
        "value": "28"
      }
    },
    "alert-main": {
      "type": "Alert",
      "props": {
        "type": "error",
        "message": "fetch-tweets has found zero new mentions for 28 straight days."
      }
    },
    "section-cause": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "cause-heading",
        "cause-text"
      ]
    },
    "cause-heading": {
      "type": "Heading",
      "props": {
        "text": "Likely Cause",
        "level": "h3"
      }
    },
    "cause-text": {
      "type": "Text",
      "props": {
        "text": "XAI_API_KEY not set — WebSearch fallback rarely surfaces fresh tweets.",
        "variant": "body"
      }
    },
    "section-fix": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "fix-heading",
        "fix-text"
      ]
    },
    "fix-heading": {
      "type": "Heading",
      "props": {
        "text": "Fix",
        "level": "h3"
      }
    },
    "fix-text": {
      "type": "Text",
      "props": {
        "text": "Set XAI_API_KEY in repo secrets to enable direct X/Twitter search via Grok.",
        "variant": "body"
      }
    }
  }
}
