{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Push Recap — 2026-11-16"
      },
      "children": [
        "repo-info",
        "separator1",
        "maintenance",
        "separator2",
        "key-changes",
        "separator3",
        "stats-section",
        "separator4",
        "full-recap-link"
      ]
    },
    "repo-info": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "repo-heading",
        "commits-info"
      ]
    },
    "repo-heading": {
      "type": "Heading",
      "props": {
        "text": "aaronjmars/MiroShark",
        "level": "h2"
      }
    },
    "commits-info": {
      "type": "Text",
      "props": {
        "text": "2 substantive commits by dependabot[bot]",
        "variant": "caption"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "maintenance": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "maint-title",
        "maint-desc"
      ]
    },
    "maint-title": {
      "type": "Heading",
      "props": {
        "text": "Dependency Maintenance",
        "level": "h3"
      }
    },
    "maint-desc": {
      "type": "Text",
      "props": {
        "text": "Two Dependabot PRs merged updating six packages across frontend and root. PR #360 grouped five frontend deps — axios patch (1.21.1), marked minor (18.2.0), vue-router minor (5.5.0), vite patch (8.3.8), and plugin-vue patch (6.0.11). PR #359 patched the root concurrently runner (10.0.7).",
        "variant": "body"
      }
    },
    "separator2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "key-changes": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "changes-title",
        "changes-list"
      ]
    },
    "changes-title": {
      "type": "Heading",
      "props": {
        "text": "Key Changes",
        "level": "h3"
      }
    },
    "changes-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "change1",
        "change2",
        "change3"
      ]
    },
    "change1": {
      "type": "Text",
      "props": {
        "text": "vue-router 5.4.0 → 5.5.0 and marked 18.1.3 → 18.2.0 (minor bumps — new features available)",
        "variant": "body"
      }
    },
    "change2": {
      "type": "Text",
      "props": {
        "text": "vite/rolldown toolchain bumped with new optional WASM target support",
        "variant": "body"
      }
    },
    "change3": {
      "type": "Text",
      "props": {
        "text": "axios follow-redirects minimum raised to 1.16.2",
        "variant": "body"
      }
    },
    "separator3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stats-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stats-title",
        "stats-items"
      ]
    },
    "stats-title": {
      "type": "Heading",
      "props": {
        "text": "Stats",
        "level": "h3"
      }
    },
    "stats-items": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat-files",
        "stat-additions",
        "stat-removals"
      ]
    },
    "stat-files": {
      "type": "Stat",
      "props": {
        "label": "Files Changed",
        "value": "4"
      }
    },
    "stat-additions": {
      "type": "Stat",
      "props": {
        "label": "Lines Added",
        "value": "184",
        "trend": "up"
      }
    },
    "stat-removals": {
      "type": "Stat",
      "props": {
        "label": "Lines Removed",
        "value": "96",
        "trend": "down"
      }
    },
    "separator4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "full-recap-link": {
      "type": "StoryLink",
      "props": {
        "title": "Full Recap",
        "href": "https://github.com/AITOBIAS04/CHORUS/blob/main/articles/push-recap-2026-11-16.md",
        "source": "GitHub"
      }
    }
  }
}
