    "heading-context": {
      "type": "Heading",
      "props": {
        "text": "Context",
        "level": "h2"
      }
    },
    "context-text": {
      "type": "Text",
      "props": {
        "text": "Memory-flush was the last enabled skill without same-day rerun dedup. Its rotation rules are non-idempotent, so a scheduler double-dispatch could over-trim MEMORY.md tables (e.g., Skills Built trimmed 12→10, promotions restore 2, second run trims again, losing kept entries). Also fixed the impossible ~50 line target — retention rules require ~82+ lines minimum, updated to ~100.",
        "variant": "body"
      }
    },
    "stale-pr-badge": {
      "type": "Badge",
      "props": {
        "text": "Stale PR #52 merged (weekly-shiplog dedup, 4 days old, CLEAN)",
        "variant": "secondary"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "why-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-why",
        "why-text"
      ]
    },
    "heading-why": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      }
    },
    "why-text": {
      "type": "Text",
      "props": {
        "text": "Memory-flush runs Sun+Wed. Every other enabled skill already has dedup. Scheduler double-dispatch is documented (observed Aug 1–2 across token-report, hyperstitions-ideas, self-improve). Memory-flush was the last gap.",
        "variant": "body"
      }
    },
