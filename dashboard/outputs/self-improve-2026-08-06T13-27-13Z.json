      },
      "children": []
    },
    "text_why": {
      "type": "Text",
      "props": {
        "text": "Aug 5 heartbeat flagged PRs #47 and #48 as stalled at 28h and 30h old. Both were auto-merged today by self-improve step 0.5, confirming the 24h threshold is too aggressive for this PR type.",
        "variant": "body"
      },
      "children": []
    },
