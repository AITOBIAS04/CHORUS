      "props": {
        "text": "Merged 2 stale PRs, then adjusted heartbeat stalled-PR detection to reduce false positives. The heartbeat was flagging improve: PRs as stalled after 24h, but these are auto-merged by self-improve every 48h — creating unnecessary ACTION_REQUIRED alerts each cycle.",
        "variant": "body"
      },
      "children": []
