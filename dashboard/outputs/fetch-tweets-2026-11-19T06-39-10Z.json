      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "diagnostic-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "cause-heading",
        "cause-text",
        "fix-heading",
        "fix-text"
      ]
    },
    "cause-heading": {
      "type": "Heading",
      "props": {
        "text": "Likely cause",
        "level": "h4"
      }
    },
    "cause-text": {
      "type": "Text",
      "props": {
        "text": "XAI_API_KEY not set — WebSearch fallback rarely surfaces fresh tweets.",
        "variant": "body"
      }
    },
    "fix-heading": {
      "type": "Heading",
      "props": {
        "text": "Fix",
        "level": "h4"
      }
    },
    "fix-text": {
      "type": "Text",
      "props": {
        "text": "Set XAI_API_KEY in repo secrets to enable direct X/Twitter search via Grok.",
        "variant": "body"
      }
    }
  }
