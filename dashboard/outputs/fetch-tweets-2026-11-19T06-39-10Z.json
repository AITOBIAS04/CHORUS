{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Social Monitor Dark — 56 consecutive days"
      },
      "children": [
        "alert-status",
        "separator-1",
        "diagnostic-stack"
      ]
    },
    "alert-status": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "title": "Zero new mentions for 56 days",
