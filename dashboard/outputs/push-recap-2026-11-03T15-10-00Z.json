        "level": "h2"
      }
    },
    "text_twitter": {
      "type": "Text",
      "props": {
        "text": "reply-maker, mention-radar, and write-tweet all switch from xAI Grok x_search to twitterapi.io as primary data source. xAI drops to fallback, WebSearch to last resort. All three now require TWITTER_API_KEY. Structured JSON responses replace free-text Grok summaries."
      }
