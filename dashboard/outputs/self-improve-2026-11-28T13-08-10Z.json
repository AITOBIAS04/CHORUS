      },
      "children": [
        "stale-section",
        "sep1",
        "problem-section",
        "sep2",
        "solution-section",
        "sep3",
        "impact-section",
        "sep4",
        "pr-link"
      ]
    },
    "stale-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stale-heading",
        "stale-items"
      ]
    },
    "stale-heading": {
