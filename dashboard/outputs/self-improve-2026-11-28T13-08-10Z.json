    "problem-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "problem-heading",
        "problem-text",
        "history-text",
        "incident-alert"
      ]
    },
    "problem-heading": {
      "type": "Heading",
      "props": {
        "text": "Problem",
        "level": "h3"
      },
      "children": []
    },
    "problem-text": {
      "type": "Text",
      "props": {
        "text": "The existing log-file dedup fails when GitHub Actions dispatches the same cron twice on separate runners — each runner has its own filesystem, so the second run creates a competing PR."
      },
      "children": []
    },
    "history-text": {
      "type": "Text",
      "props": {
        "text": "Observed twice: Aug 2 (PRs #45/#46) and Nov 24 (PRs #93/#94 both went DIRTY within hours).",
        "variant": "caption"
      },
      "children": []
    },
    "incident-alert": {
      "type": "Alert",
      "props": {
        "title": "Nov 24 Double-dispatch Incident",
        "message": "Two competing improve PRs created 95 minutes apart. Both went DIRTY immediately and sat for 4 days before being closed today. Two full improvement cycles wasted — the ATL detection alert and the volatile-file enforcement script both need to be re-proposed.",
        "type": "warning"
      },
      "children": []
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "solution-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "solution-heading",
        "solution-text",
        "changes-heading",
        "changes-detail"
      ]
    },
    "solution-heading": {
      "type": "Heading",
      "props": {
        "text": "Solution",
        "level": "h3"
      },
      "children": []
    },
    "solution-text": {
      "type": "Text",
      "props": {
        "text": "Added a GitHub API-based concurrent dispatch guard to self-improve Step 0."
      },
      "children": []
    },
    "changes-heading": {
      "type": "Heading",
      "props": {
        "text": "What Changed",
        "level": "h4"
      },
      "children": []
    },
    "changes-detail": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "file-badge",
        "implementation-text"
      ]
    },
    "file-badge": {
      "type": "Badge",
      "props": {
        "text": "skills/self-improve/SKILL.md",
        "variant": "outline"
      },
      "children": []
    },
    "implementation-text": {
      "type": "Text",
      "props": {
        "text": "Split Step 0 into (a) log check (existing, fast) and (b) API check that queries gh pr list for open improve: PRs created today. Logs SELF_IMPROVE_RERUN_CONCURRENT when a concurrent dispatch is detected."
      },
      "children": []
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "impact-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "impact-heading",
        "impact-stat"
      ]
    },
    "impact-heading": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      },
      "children": []
    },
    "impact-stat": {
