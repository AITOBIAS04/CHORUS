      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "pr-95",
        "pr-93",
        "pr-94"
      ]
    },
    "pr-95": {
      "type": "Badge",
      "props": {
        "text": "#95: Merged — fetch-tweets counter fix",
        "variant": "secondary"
      },
      "children": []
    },
    "pr-93": {
      "type": "Badge",
      "props": {
        "text": "#93: Closed — DIRTY/conflicting (95h)",
        "variant": "destructive"
      },
      "children": []
