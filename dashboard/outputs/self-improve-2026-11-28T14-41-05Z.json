{
  "root": "card-root",
  "state": {},
  "elements": {
    "card-root": {
      "type": "Card",
      "props": {
        "title": "Agent Self-Improvement — 2026-11-28"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "headline",
        "sep1",
        "problem-section",
        "sep2",
        "why-section",
        "sep3",
        "changes-section",
        "sep4",
        "impact-section",
        "sep5",
        "pr-link"
      ]
    },
    "headline": {
      "type": "Heading",
      "props": {
        "text": "Volatile file exclusion is now enforced by script, not instructions.",
        "level": "h2"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "problem-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "problem-heading",
        "problem-text"
      ]
    },
    "problem-heading": {
      "type": "Heading",
      "props": {
        "text": "Problem",
        "level": "h3"
      }
    },
    "problem-text": {
      "type": "Text",
      "props": {
        "text": "The agent's self-improve Step 4 had text instructions to unstage volatile files (memory/, .outputs/, dashboard/outputs/) before committing. The agent ignored these instructions repeatedly — PRs #94 and #96 both included volatile files and went DIRTY/CONFLICTING within hours, wasting the improvement."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "why-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "why-heading",
        "why-text"
      ]
    },
    "why-heading": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      }
    },
    "why-text": {
      "type": "Text",
      "props": {
        "text": "PR #96 (created earlier today) included 5 volatile files despite the safety net added in PR #91. Same failure pattern as PR #94 (closed Nov 28). Text-only multi-step instructions are unreliable — the agent skips them under context pressure."
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "changes-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "changes-heading",
        "changes-stack"
      ]
    },
    "changes-heading": {
      "type": "Heading",
      "props": {
        "text": "What changed",
        "level": "h3"
      }
    },
    "changes-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "change1",
        "change2"
      ]
    },
    "change1": {
      "type": "Text",
      "props": {
        "text": "scripts/commit-improvement.sh (new): enforcing script that stages specified files, strips volatile paths mechanically, verifies the staged set, and refuses to commit if nothing survives cleanup"
      }
    },
    "change2": {
      "type": "Text",
      "props": {
        "text": "skills/self-improve/SKILL.md: Step 4 simplified from 15 lines of manual staging/cleanup instructions to a single script call"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "impact-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "impact-heading",
        "impact-text"
      ]
    },
    "impact-heading": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      }
    },
    "impact-text": {
      "type": "Text",
      "props": {
        "text": "Future self-improve PRs will not include volatile files. This prevents the DIRTY-on-creation pattern that killed 3 of the last 4 improvement PRs (#93, #94, #96). Improvements should land more reliably."
      }
    },
    "sep5": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "pr-link": {
      "type": "StoryLink",
      "props": {
        "title": "PR #97: Enforce volatile file exclusion by script",
        "href": "https://github.com/AITOBIAS04/CHORUS/pull/97",
        "source": "GitHub"
      }
    }
  }
}
