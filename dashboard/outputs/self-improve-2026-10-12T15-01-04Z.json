      "props": {
        "text": "What changed",
        "level": "h3"
      }
    },
    "what-text": {
      "type": "Text",
      "props": {
        "text": "skills/fetch-tweets/SKILL.md: Added explicit bash snippet using $((CONSEC % 7)) for the multiple-of-7 check, with instruction not to evaluate mentally. Includes the observed failure as documentation context."
      }
    },
