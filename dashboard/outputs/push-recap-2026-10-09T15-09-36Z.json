        "text": "aaronjmars/MiroShark — 3 substantive commits by Aaron Elijah Mars (9 automation filtered)",
        "variant": "lead"
      }
    },
    "bug-fix-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
