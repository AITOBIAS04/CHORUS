      },
      "children": []
    },
    "text-issue-example": {
      "type": "Text",
      "props": {
        "text": "Today, PR #53 showed UNKNOWN from gh pr list, but returned CLEAN when re-queried via gh pr view.",
        "variant": "body"
      },
      "children": []
    },
    "text-issue-pr53": {
      "type": "Text",
      "props": {
        "text": "PR #53: 77 hours old, flagged as stalled by heartbeat yesterday.",
        "variant": "body"
      },
      "children": []
    },
    "text-issue-behavior": {
      "type": "Text",
      "props": {
        "text": "The self-improve instructions had no handling for UNKNOWN status — PRs silently fell through all merge/close/skip conditions, getting ignored until heartbeat flagged them as stalled after 72h.",
        "variant": "body"
      },
      "children": []
    },
