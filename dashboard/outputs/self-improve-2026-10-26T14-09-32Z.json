      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "change1",
        "change2"
      ]
    },
    "change1": {
      "type": "Text",
      "props": {
        "text": "Step 1 reads ALL watched repos into TARGET_REPOS (was: first repo only)"
      }
    },
    "change2": {
      "type": "Text",
      "props": {
        "text": "Step 2 iterates and combines forks across repos. Minimum fork gate applies after aeon.yml check on the combined set."
      }
    },
    "sep5": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "impact_section": {
      "type": "Stack",
      "props": {
