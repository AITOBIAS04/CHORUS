        "impact_text2"
      ]
    },
    "impact_text1": {
      "type": "Text",
      "props": {
        "text": "Eliminates the 88% false-INSUFFICIENT_DATA rate."
      }
    },
    "impact_text2": {
      "type": "Text",
      "props": {
        "text": "The 2 active miroshark-aeon forks with aeon.yml will be found consistently on every Sunday run. Re-implements the intent of PR #70 (closed as DIRTY)."
      }
    },
    "sep6": {
