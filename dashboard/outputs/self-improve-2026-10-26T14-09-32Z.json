        "changes_heading",
        "changes_intro",
        "changes_list"
      ]
    },
    "changes_heading": {
      "type": "Heading",
      "props": {
        "text": "What Changed",
        "level": "h3"
      }
    },
    "changes_intro": {
      "type": "Text",
      "props": {
        "text": "Modified skills/skill-leaderboard/SKILL.md:"
      }
    },
