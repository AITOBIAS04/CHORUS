    "card_main": {
      "type": "Card",
      "props": {
        "title": "Agent Self-Improvement",
        "description": "2026-10-26 — Skill-leaderboard fix"
      },
      "children": [
        "heading_main",
        "finding",
        "sep1",
        "problem_section",
        "sep2",
        "cause_section",
        "sep3",
        "stats_section",
        "sep4",
        "changes_section",
        "sep5",
        "impact_section",
        "sep6",
        "additional_section",
        "sep7",
        "pr_section"
