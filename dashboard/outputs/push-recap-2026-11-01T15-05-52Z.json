        "text": "CI/CD Hardening: PR #348",
        "level": "h3"
      }
    },
    "pr_desc": {
      "type": "Text",
      "props": {
        "text": "Adds job timeouts and concurrency controls to both GitHub Actions workflows. Every CI job now has an explicit timeout (30min for Docker builds, 15min for tests/lint), and the test workflow cancels in-progress runs when a new push lands on the same PR branch — preventing queue pile-ups and stuck runners during rapid iteration."
      }
    },
    "changes_heading": {
      "type": "Heading",
      "props": {
        "text": "Key changes:",
        "level": "h4"
      }
    },
