        "gap": "sm"
      },
      "children": [
        "change1",
        "change2",
        "change3"
      ]
    },
    "change1": {
      "type": "Text",
      "props": {
        "text": "concurrency group on tests.yml cancels superseded PR runs (main-branch builds unaffected)"
      }
    },
    "change2": {
      "type": "Text",
      "props": {
        "text": "timeout-minutes: 30 on Docker build-and-push job"
      }
    },
    "change3": {
      "type": "Text",
