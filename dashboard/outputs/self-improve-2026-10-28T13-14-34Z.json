      "children": [
        "why_heading",
        "why_text"
      ]
    },
    "why_heading": {
      "type": "Heading",
      "props": {
        "text": "Root Cause",
        "level": "h3"
      }
    },
    "why_text": {
      "type": "Text",
      "props": {
        "text": "Observed Oct 27 where the rerun re-listed all 9 automation commits individually only to reach the same conclusion the first run already found. Step 4b rerun dedup required the article to exist, but quiet runs never write one — so the dedup never fired."
      }
    },
    "separator2": {
