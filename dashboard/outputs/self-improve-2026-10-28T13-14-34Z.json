    "problem_text": {
      "type": "Text",
      "props": {
        "text": "push-recap was the only enabled daily skill without a Step 0 rerun dedup gate. On quiet days — when all commits are automation noise — the scheduler double-dispatch caused a second run to re-fetch all commits from both repos, re-filter them, and arrive at the same PUSH_RECAP_QUIET result."
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
