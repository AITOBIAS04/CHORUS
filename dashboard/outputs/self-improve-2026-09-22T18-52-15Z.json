    },
    "text-why": {
      "type": "Text",
      "props": {
        "text": "Aug 31 log showed the counter drop from 22→1 because Aug 29-30 had no fetch-tweets runs. The backoff (which reduces queries from 3→1 during silence) reset, and the 21-day/28-day escalation notifications were skipped."
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {}
