    "text_why": {
      "type": "Text",
      "props": {
        "text": "On Sep 27 (Sunday), heartbeat flagged hyperstitions-ideas as \"missing\" and \"overdue ~9h\" — a false positive. The skill is Saturday-only (0 10 * * 6) and had correctly run on Sep 26. The day-of-week rule existed but was a buried bullet point that the LLM overlooked during the scan. Second heartbeat run caught the error, but the false notification had already been sent.",
        "variant": "body"
      },
      "children": []
    },
