{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Repo Pulse"
      },
      "children": [
        "mainStack"
      ]
    },
    "mainStack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "dateText",
        "repoLink",
        "separator1",
        "statsStack",
        "separator2",
        "newForksSection"
      ]
    },
    "dateText": {
      "type": "Text",
      "props": {
        "text": "2026-10-10",
        "variant": "muted"
      }
    },
    "repoLink": {
      "type": "StoryLink",
      "props": {
        "title": "aaronjmars/MiroShark",
        "href": "https://github.com/aaronjmars/MiroShark",
        "source": "GitHub"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "statsStack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "starsStat",
        "forksStat"
      ]
    },
    "starsStat": {
      "type": "Stat",
      "props": {
        "label": "Stars",
        "value": "1,467",
        "delta": "+2",
        "trend": "up"
      }
    },
    "forksStat": {
      "type": "Stat",
      "props": {
        "label": "Forks",
        "value": "303",
        "delta": "+1",
        "trend": "up"
      }
    },
    "separator2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "newForksSection": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "newForksHeading",
        "newForkLink"
      ]
    },
    "newForksHeading": {
      "type": "Heading",
      "props": {
        "text": "New forks",
        "level": "h4"
      }
    },
    "newForkLink": {
      "type": "StoryLink",
      "props": {
        "title": "OpmRain/MiroShark",
        "href": "https://github.com/OpmRain/MiroShark",
        "source": "GitHub"
      }
    }
  }
}
