      "props": {
        "text": "aaronjmars/MiroShark — 2 substantive commits by aaronjmars",
        "variant": "lead"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section-cicd": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-cicd",
        "text-cicd"
      ]
    },
    "heading-cicd": {
      "type": "Heading",
      "props": {
        "text": "CI/CD Infrastructure Overhaul",
        "level": "h3"
      }
    },
    "text-cicd": {
      "type": "Text",
      "props": {
        "text": "Docker images now publish automatically from main on every relevant push (previously tag-only). All 4 CI jobs switched from paid Blacksmith runners to free GitHub-hosted ubuntu-latest — sub-30s jobs meant queue wait was the bottleneck. Dependabot reconfigured to group ALL updates (majors included) into one weekly PR per ecosystem."
      }
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section-deps": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-deps",
        "text-deps",
        "text-deps-notable"
      ]
    },
    "heading-deps": {
      "type": "Heading",
      "props": {
        "text": "Dependency Updates",
        "level": "h3"
      }
    },
    "text-deps": {
      "type": "Text",
      "props": {
        "text": "Bundled Dependabot PR merges week's bumps — DOMPurify 3.4.18 (XSS patch), Marked 18.2.1, vue-router 5.5.1, setup-uv v10.4.0."
      }
    },
    "text-deps-notable": {
      "type": "Text",
      "props": {
        "text": "Notable transitive: chokidar 5→6 (Node >=22.22 required).",
        "variant": "muted"
      }
    },
    "separator-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "section-keychanges": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading-keychanges",
        "keychange-1",
        "keychange-2",
        "keychange-3"
      ]
    },
    "heading-keychanges": {
      "type": "Heading",
      "props": {
        "text": "Key changes",
        "level": "h3"
      }
    },
    "keychange-1": {
      "type": "Text",
      "props": {
        "text": "Docker image reference moved from ghcr.io/aaronjmars/miroshark to ghcr.io/miroshark/miroshark — forks using old path will 404"
      }
    },
    "keychange-2": {
      "type": "Text",
      "props": {
        "text": "docker-compose.yml now has build: . fallback so compose works without a published image"
      }
    },
    "keychange-3": {
      "type": "Text",
      "props": {
        "text": "Blacksmith runners removed across all CI jobs (unit, frontend, camel-smoke, lint)"
      }
    },
