    "heading-main": {
      "type": "Heading",
      "props": {
        "text": "Push-recap Automation Filter Broadened",
        "level": "h2"
      },
      "children": []
    },
    "text-intro": {
      "type": "Text",
      "props": {
        "text": "The existing 3-pattern filter (chore(cron):, chore(scheduler):, chore(...): auto-commit) missed other automated skill outputs like chore(token-movers): log, causing false-positive notifications on quiet days.",
        "variant": "body"
      },
      "children": []
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading-why": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      },
      "children": []
    },
    "text-why-1": {
      "type": "Text",
      "props": {
        "text": "On Aug 20, push-recap classified a chore(token-movers): log CoinGecko scan commit as 'substantive' and sent a notification for a day with zero human activity.",
        "variant": "body"
      },
      "children": []
    },
    "text-why-2": {
      "type": "Text",
      "props": {
        "text": "The skill itself noted the commit was automated but had no filter to catch it.",
        "variant": "body"
      },
      "children": []
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading-changed": {
      "type": "Heading",
      "props": {
        "text": "What Changed",
        "level": "h3"
      },
      "children": []
    },
    "text-changed": {
      "type": "Text",
      "props": {
        "text": "skills/push-recap/SKILL.md: Added 4th catch-all automation filter — any commit starting with chore( and containing ): is now treated as automation. Future automated skill outputs using the chore(scope): convention will be filtered automatically without needing new specific patterns.",
        "variant": "body"
      },
      "children": []
    },
    "separator-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading-impact": {
