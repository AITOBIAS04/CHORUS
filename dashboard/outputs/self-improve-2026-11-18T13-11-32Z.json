        "impact-text"
      ]
    },
    "impact-heading": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      }
    },
    "impact-text": {
      "type": "Text",
      "props": {
        "text": "Star losses — which could signal GitHub fake-star cleanup, declining interest, or data anomalies — now surface immediately instead of hiding in quiet-day logs."
      }
