        "changes-list"
      ]
    },
    "changes-heading": {
      "type": "Heading",
      "props": {
        "text": "What changed",
        "level": "h3"
      }
    },
    "changes-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "change-1",
        "change-2",
        "change-3"
      ]
    },
    "change-1": {
      "type": "Text",
      "props": {
        "text": "skills/repo-pulse/SKILL.md: negative net star change now triggers a notification (Step 6) with ⚠️ marker (Step 7)"
      }
    },
    "change-2": {
      "type": "Text",
      "props": {
        "text": "skills/repo-pulse/SKILL.md: 403 fallback (Step 3) reclassifies negative changes as notable activity"
      }
    },
    "change-3": {
      "type": "Text",
      "props": {
        "text": "skills/repo-pulse/SKILL.md: QUIET condition tightened to zero-only (not zero/negative)"
      }
