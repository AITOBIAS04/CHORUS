    "description": {
      "type": "Text",
      "props": {
        "text": "repo-pulse now alerts on star decreases instead of silently treating them as 'no activity.' Previously, any negative net star change was classified as REPO_PULSE_QUIET — the operator got no notification when stars dropped."
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {}
    },
    "why-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "why-heading",
        "why-text"
      ]
    },
    "why-heading": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      }
    },
    "why-text": {
      "type": "Text",
      "props": {
        "text": "On Nov 15, stars fell from 1,489 to 1,487 (first-ever decrease). The skill logged it correctly but sent no alert. The operator only learned from the daily article, not the pulse — a monitoring gap for a metric with an active 1,500-star hyperstition."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "changes-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
