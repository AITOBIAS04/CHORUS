{
  "root": "card_root",
  "state": {},
  "elements": {
    "card_root": {
      "type": "Card",
      "props": {
        "title": "Hyperstitions Idea — 2026-09-22",
        "description": "Will MiroShark receive 10 Hacktoberfest-qualifying PRs from distinct non-team contributors by October 31, 2026?"
      },
      "children": [
        "main_stack"
      ]
    },
    "main_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "coordination_section",
        "separator_1",
        "why_now_section",
        "separator_2",
        "resolution_section",
        "separator_3",
        "scores_section",
        "separator_4",
        "link_section"
      ]
    },
    "coordination_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "coord_heading",
        "coord_text"
      ]
    },
    "coord_heading": {
      "type": "Heading",
      "props": {
        "text": "The Coordination Play",
        "level": "h3"
      }
    },
    "coord_text": {
      "type": "Text",
      "props": {
        "text": "Hacktoberfest starts in 9 days and MiroShark has 300 forks with exactly zero community PRs — ever. The agent has designed 40+ features it literally cannot ship because it lacks push access. Someone needs to set GH_GLOBAL, tag the repo with the hacktoberfest topic, label issues as good-first-issue, and share it in Hacktoberfest channels. The market existing makes people look at the repo during the one month when open-source contribution is gamified and incentivized globally."
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "why_now_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "why_heading",
        "why_text"
      ]
    },
    "why_heading": {
      "type": "Heading",
      "props": {
        "text": "Why Now",
        "level": "h3"
      }
    },
    "why_text": {
      "type": "Text",
      "props": {
        "text": "MiroShark just crossed 300 forks — a round number that masks a 0% conversion rate. The agent has been autonomously designing features for 190+ days but has been push-blocked for 83+ consecutive runs. Hacktoberfest is the only annual event that turns passive forkers into active contributors at scale, and the window to prepare is closing (Oct 1 deadline for repo readiness)."
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "resolution_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "resolution_heading",
        "resolution_text"
      ]
    },
    "resolution_heading": {
      "type": "Heading",
      "props": {
        "text": "Resolution",
        "level": "h3"
      }
    },
    "resolution_text": {
      "type": "Text",
      "props": {
        "text": "YES if 10 or more merged PRs from 10 distinct GitHub accounts (excluding aaronjmars, aeonframework, dependabot) land in aaronjmars/MiroShark between October 1–31, 2026. PRs must not be spam or trivial (consistent with Hacktoberfest rules)."
      }
    },
    "separator_3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "scores_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "scores_heading",
        "scores_grid"
      ]
    },
    "scores_heading": {
      "type": "Heading",
      "props": {
        "text": "Scores",
        "level": "h3"
      }
    },
    "scores_grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "reflexivity_stat",
        "viral_stat"
      ]
    },
    "reflexivity_stat": {
      "type": "Stat",
      "props": {
        "label": "Reflexivity",
        "value": "5/5"
      }
    },
    "viral_stat": {
      "type": "Stat",
      "props": {
        "label": "Viral",
        "value": "4/5"
      }
    },
    "separator_4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "link_section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "soon_text",
        "hyperstitions_link"
      ]
    },
    "soon_text": {
      "type": "Text",
      "props": {
        "text": "Soon on:",
        "variant": "muted"
      }
    },
    "hyperstitions_link": {
      "type": "Link",
      "props": {
        "label": "https://www.hyperstitions.com/",
        "href": "https://www.hyperstitions.com/"
      }
    }
  }
}
