    "heading-coordination": {
      "type": "Heading",
      "props": {
        "text": "The Coordination Play",
        "level": "h3"
      }
    },
    "text-coordination": {
      "type": "Text",
      "props": {
        "text": "An AI agent can build 41 API surfaces and ship a README overhaul, but it cannot star its own repo, share it on Reddit, post it to Hacker News, or tweet about it. The market turns 1,427 passive stargazers and 298 forkers into an activation pool — each person who shares the repo to move the market also moves the repo closer to trending. GitHub Trending is self-reinforcing: visibility begets stars begets more visibility.",
        "variant": "body"
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {}
    },
    "section-stats": {
      "type": "Grid",
