        "level": "h3"
      }
    },
    "text-resolution": {
      "type": "Text",
      "props": {
        "text": "YES if MiroShark appears on github.com/trending (any language filter, daily or weekly timeframe) at any point on or before September 15, 2026.",
        "variant": "lead"
      }
    },
    "text-verification": {
      "type": "Text",
      "props": {
        "text": "Verified via GitHub Trending page snapshot or third-party archive (e.g. github-trending-repos). One appearance is sufficient.",
