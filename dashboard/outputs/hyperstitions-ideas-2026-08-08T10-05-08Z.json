      "children": [
        "stat-stars",
        "stat-forks",
        "stat-surfaces"
      ]
    },
    "stat-stars": {
      "type": "Stat",
      "props": {
        "label": "Stars",
        "value": "1,427"
      }
    },
    "stat-forks": {
