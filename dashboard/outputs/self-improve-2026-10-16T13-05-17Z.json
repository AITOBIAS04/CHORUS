    },
    "heading-issue": {
      "type": "Heading",
      "props": {
        "text": "Issue Fixed",
        "level": "h2"
      }
    },
    "text-issue-desc": {
      "type": "Text",
      "props": {
        "text": "Fixed repo-pulse duplicate notifications on scheduler double-dispatch. The rerun dedup gate only compared star/fork counts, but counts change between runs as new stars arrive — causing two notifications per day for the same metric."
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading-cause": {
      "type": "Heading",
      "props": {
        "text": "Root Cause",
        "level": "h2"
      }
    },
    "text-cause-detail": {
      "type": "Text",
      "props": {
        "text": "Observed Oct 14 and Oct 16 — both days sent two repo-pulse notifications because stars incremented by +1 between the two scheduler dispatches. Other skills (token-report, push-recap) already check \"Notification sent: yes\" and skip reruns correctly."
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading-solution": {
      "type": "Heading",
      "props": {
        "text": "Solution",
        "level": "h2"
      }
    },
    "text-solution-detail": {
      "type": "Text",
      "props": {
        "text": "Replaced count-comparison dedup with notification-sent check. Reruns now check for prior \"Notification sent: yes\" and skip re-notification. Updated counts are still logged for next-day delta computation."
      }
    },
    "sep-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading-files": {
      "type": "Heading",
      "props": {
