        "level": "h2"
      }
    },
    "text-files-detail": {
      "type": "Text",
      "props": {
        "text": "skills/repo-pulse/SKILL.md: Replaced count-comparison dedup with notification-sent check."
      }
    },
    "sep-4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading-prstatus": {
