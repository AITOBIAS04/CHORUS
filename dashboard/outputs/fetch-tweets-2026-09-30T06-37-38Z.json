{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Social Monitor Dark — 7 consecutive days"
      },
      "children": [
        "alert_main",
        "separator_1",
        "cause_section",
        "separator_2",
        "fix_section"
      ]
    },
    "alert_main": {
      "type": "Alert",
      "props": {
        "title": "Zero new mentions detected",
        "message": "fetch-tweets has found zero new mentions for 7 straight days.",
        "type": "warning"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "cause_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "cause_heading",
        "cause_text"
      ]
    },
    "cause_heading": {
      "type": "Heading",
      "props": {
        "text": "Likely cause",
        "level": "h4"
      }
    },
    "cause_text": {
      "type": "Text",
      "props": {
        "text": "XAI_API_KEY not set — WebSearch fallback rarely surfaces fresh tweets.",
        "variant": "body"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "fix_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "fix_heading",
        "fix_text"
      ]
    },
    "fix_heading": {
      "type": "Heading",
      "props": {
        "text": "Fix",
        "level": "h4"
      }
    },
    "fix_text": {
      "type": "Text",
      "props": {
        "text": "Set XAI_API_KEY in repo secrets to enable direct X/Twitter search via Grok.",
        "variant": "body"
      }
    }
  }
}
