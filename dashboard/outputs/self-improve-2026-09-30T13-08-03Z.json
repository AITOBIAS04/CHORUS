    },
    "summary-text": {
      "type": "Text",
      "props": {
        "text": "Token-report skill now has WebFetch fallback for all GeckoTerminal API calls. Previously, 4 curl calls had zero fallback — if the GitHub Actions sandbox blocked outbound curl, the daily price report would fail silently.",
        "variant": "lead"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "why-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "why-heading",
        "why-text"
      ]
    },
    "why-heading": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      }
    },
    "why-text": {
      "type": "Text",
      "props": {
        "text": "CLAUDE.md requires WebFetch fallback for all public API curl calls. The token-report (daily at 06:00 UTC) is the most frequently-run data skill and the only one relying on raw curl for its primary data source. Other skills use gh api (auth-handled) or already have WebFetch paths."
      }
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "changes-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "changes-heading",
        "changes-bullet-1",
        "changes-bullet-2",
        "changes-bullet-3"
      ]
    },
    "changes-heading": {
      "type": "Heading",
      "props": {
        "text": "What changed",
        "level": "h3"
      }
    },
    "changes-bullet-1": {
      "type": "Text",
      "props": {
        "text": "• skills/token-report/SKILL.md: Added Sandbox note section. Each curl step now falls back to WebFetch on failure."
      }
    },
    "changes-bullet-2": {
      "type": "Text",
      "props": {
        "text": "• Steps 1-2 (token + pool data) are critical — only trigger TOKEN_REPORT_NO_DATA if both methods fail."
      }
    },
    "changes-bullet-3": {
      "type": "Text",
      "props": {
        "text": "• Steps 3-4 (OHLCV + trades) are supplementary — report proceeds without them."
      }
    },
    "separator-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "impact-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "impact-heading",
        "impact-text"
      ]
    },
    "impact-heading": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      }
    },
    "impact-text": {
      "type": "Text",
      "props": {
        "text": "Prevents silent daily report failure if sandbox curl is intermittently blocked. The operator will always get price data as long as WebFetch works."
      }
    },
    "separator-4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
