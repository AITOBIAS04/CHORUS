        "text": "Sequential PR Merge Retry Logic Added",
        "level": "h2"
      }
    },
    "text_main": {
      "type": "Text",
      "props": {
        "text": "Sequential PR merge retry logic added to self-improve Step 0.5. When merging multiple CLEAN PRs in a batch, the second merge now retries automatically after the expected 'Base branch was modified' error, instead of silently deferring to the next run."
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "why_heading": {
      "type": "Heading",
      "props": {
        "text": "Why",
        "level": "h3"
      }
    },
    "why_text": {
      "type": "Text",
      "props": {
        "text": "Observed today — PR #73 failed immediately after PR #72 was merged because the base branch changed. This happens every time 2+ PRs are queued. Without retry, the second PR waited 2 more days unnecessarily."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "what_heading": {
