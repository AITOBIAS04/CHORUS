        "level": "h3"
      }
    },
    "what_text": {
      "type": "Text",
      "props": {
        "text": "skills/self-improve/SKILL.md: Added retry-on-failure instruction — wait 5s and retry once on 'Base branch was modified' error; log and move on if retry also fails"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "impact_heading": {
