        "type": "warning"
      }
    },
    "security_detail": {
      "type": "Text",
      "props": {
        "text": "Bundled Dependabot PR #331 lands the shell-quote 1.9.0→1.12.0 upgrade inside concurrently — this closes CVE-2026-9277, the critical injection vulnerability affecting 214M monthly npm downloads. Also bumps vue-router to 5.4.0 (pulls @babel/parser v8 and ast-walker-scope v0.10 into the tree), vite to 8.3.4 (with rolldown 1.2.13), and marked to 18.1.0.",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "token_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
