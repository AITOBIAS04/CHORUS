        "variant": "body"
      }
    },
    "link_pr": {
      "type": "Link",
      "props": {
        "label": "PR #84: Add LP Anomaly Detection",
        "href": "https://github.com/AITOBIAS04/CHORUS/pull/84"
      }
    },
    "text_impact": {
      "type": "Text",
      "props": {
        "text": "Eighty-fourth structural fix in 230 days.",
