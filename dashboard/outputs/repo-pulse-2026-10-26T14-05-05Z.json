        "value": "305",
        "delta": "+1 new",
        "trend": "up"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "new_forks_heading": {
      "type": "Heading",
      "props": {
        "text": "New forks",
        "level": "h3"
      }
    },
    "new_forks_link": {
      "type": "StoryLink",
      "props": {
        "title": "github.com/aiapienthusiast/MiroShark",
