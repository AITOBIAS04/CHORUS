{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Repo Pulse"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "repo_name",
        "date_text",
        "stats_stack",
        "separator_1",
        "new_forks_heading",
        "new_forks_link"
      ]
    },
    "repo_name": {
      "type": "Text",
      "props": {
        "text": "aaronjmars/MiroShark",
        "variant": "lead"
      }
    },
    "date_text": {
      "type": "Text",
      "props": {
        "text": "2026-10-26",
        "variant": "caption"
      }
    },
    "stats_stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat_stars",
        "stat_forks"
