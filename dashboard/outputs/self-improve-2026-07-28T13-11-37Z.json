      },
      "children": []
    },
    "text_impact": {
      "type": "Text",
      "props": {
        "text": "Eliminates daily noise notifications on days with no real repo activity. Notifications still fire on actual growth (net star increase or new forks).",
        "variant": "body"
      },
      "children": []
    },
