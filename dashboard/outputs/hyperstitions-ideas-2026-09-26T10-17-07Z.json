    "heading_coordination": {
      "type": "Heading",
      "props": {
        "text": "The coordination play",
        "level": "h3"
      }
    },
    "text_coordination": {
      "type": "Text",
      "props": {
        "text": "Three hundred forks. Zero pull requests. Hacktoberfest starts in five days with free swag for contributors — and the repo has 40+ agent-designed feature specs sitting unclaimed. The market turns a silent fork into a to-do list. Anyone holding MIROSHARK now has a reason to dust off their fork, pick a spec, and ship code. An AI agent wrote the blueprints. It needs humans to build them."
      }
    },
