    },
    "framework_heading": {
      "type": "Heading",
      "props": {
        "text": "Framework Updater — 3-Way Merge",
        "level": "h3"
      }
    },
    "framework_text": {
      "type": "Text",
      "props": {
        "text": "aeon-update previously treated any operator-customized file as a CONFLICT. Now it runs git merge-file 3-way — disjoint edits merge automatically, only true overlaps surface as conflicts. Also adds an eyebrow lock fail-safe so new upstream skills never land a CI-red PR. Pinned to claude-opus-4-8.",
        "variant": "body"
      }
    },
