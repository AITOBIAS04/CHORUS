        "core-team-badge"
      ]
    },
    "resolution-title": {
      "type": "Heading",
      "props": {
        "text": "Resolution",
        "level": "h3"
      }
    },
    "resolution-text": {
      "type": "Text",
      "props": {
        "text": "YES if at least one pull request from a GitHub account outside the core team (aaronjmars, aeon-connect[bot], dependabot[bot], AITOBIAS04) is opened against aaronjmars/MiroShark between October 1–31, 2026. Verified via GitHub PR history. The PR does not need to be merged — just opened in good faith (not spam).",
        "variant": "body"
      }
    },
    "core-team-badge": {
      "type": "Badge",
      "props": {
        "text": "Core team excluded: aaronjmars, aeon-connect[bot], dependabot[bot], AITOBIAS04",
        "variant": "secondary"
      }
    },
