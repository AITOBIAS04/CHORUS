    "main-heading": {
      "type": "Heading",
      "props": {
        "text": "Will MiroShark receive its first external pull request during Hacktoberfest 2026?",
        "level": "h2"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "coordination-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "coord-title",
        "coord-text",
        "stats-row-1"
      ]
    },
    "coord-title": {
      "type": "Heading",
      "props": {
        "text": "The coordination play",
        "level": "h3"
      }
    },
    "coord-text": {
      "type": "Text",
      "props": {
        "text": "Three hundred and two forks. Zero upstream contributions. Ever. Hacktoberfest is the one month a year the entire open-source world is actively looking for repos to contribute to — and this one has 40+ documented API surfaces, good-first-issue potential everywhere, and a live simulation engine to build on. The market turns a statistical embarrassment into a public dare. Anyone holding a fork sees the question and thinks: I could be the one who breaks the streak.",
        "variant": "body"
      }
    },
    "stats-row-1": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "stat-forks",
        "stat-contributions"
      ]
    },
    "stat-forks": {
      "type": "Stat",
      "props": {
        "label": "Forks",
        "value": "302"
      }
    },
    "stat-contributions": {
      "type": "Stat",
      "props": {
        "label": "Upstream Contributions",
        "value": "0"
      }
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "why-now-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "why-title",
        "why-text",
        "stats-row-2"
      ]
    },
    "why-title": {
      "type": "Heading",
      "props": {
        "text": "Why now",
        "level": "h3"
      }
    },
    "why-text": {
      "type": "Text",
      "props": {
        "text": "Hacktoberfest Day 3. The event runs through October 31. MiroShark sits at 1,460 stars and 302 forks with a 0% PR conversion rate — a ratio so lopsided it reads like a challenge. The x402 ecosystem entry just shipped (PR #313), the LLM gateway expanded to 10 providers, and the codebase has never been more extensible. Meanwhile 87 days of social silence means nobody is asking for contributions — the market becomes the ask.",
        "variant": "body"
      }
    },
    "stats-row-2": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat-stars",
        "stat-conversion",
        "stat-api-surfaces"
      ]
    },
    "stat-stars": {
      "type": "Stat",
      "props": {
        "label": "Stars",
        "value": "1,460"
      }
    },
    "stat-conversion": {
      "type": "Stat",
      "props": {
        "label": "PR Conversion Rate",
        "value": "0%"
      }
    },
    "stat-api-surfaces": {
      "type": "Stat",
      "props": {
        "label": "API Surfaces",
        "value": "40+"
      }
    },
    "separator-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "resolution-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
