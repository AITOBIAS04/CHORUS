    "intro-text": {
      "type": "Text",
      "props": {
        "text": "The hyperstitions-ideas skill fetches trending Polymarket data via curl for inspiration on prediction market questions. This curl call had no fallback — if the GitHub Actions sandbox blocked outbound network (which it does intermittently), the data was silently lost. All other enabled skills already had WebFetch fallbacks or used sandbox-safe gh api calls.",
        "variant": "body"
      },
      "children": []
