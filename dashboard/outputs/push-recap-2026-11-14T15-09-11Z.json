      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "badge-substantive",
        "badge-filtered"
      ]
    },
    "badge-substantive": {
      "type": "Badge",
      "props": {
        "text": "1 substantive commit by Dependabot",
