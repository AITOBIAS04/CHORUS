    "alert_main": {
      "type": "Alert",
      "props": {
        "title": "Fixed memory-flush Active Targets rule",
        "message": "Replaced rotation rule for expired hyperstition cleanup",
        "type": "success"
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading_problem": {
      "type": "Heading",
      "props": {
        "text": "The Problem",
        "level": "h3"
      },
      "children": []
    },
    "text_problem_1": {
      "type": "Text",
      "props": {
        "text": "The rotation rule required entries to be explicitly marked \"NOT CLEARED (deadline passed)\" before removal, but no skill ever applied that marker.",
        "variant": "body"
      },
      "children": []
    },
    "text_problem_2": {
      "type": "Text",
      "props": {
        "text": "Entries with embedded deadlines (e.g. \"by September 15, 2026?\") accumulated indefinitely.",
        "variant": "body"
      },
      "children": []
    },
    "text_problem_3": {
      "type": "Text",
      "props": {
        "text": "On Sep 27, memory-flush found 6 entries with Sep 15 deadlines and retained them within the 14-day window. These would never be cleaned up because the rule depended on a marker string that nothing sets. The LLM was interpreting the rule loosely, risking inconsistent behavior across runs.",
        "variant": "body"
      },
      "children": []
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading_solution": {
      "type": "Heading",
      "props": {
        "text": "The Solution",
        "level": "h3"
      },
      "children": []
    },
    "text_solution": {
      "type": "Text",
      "props": {
        "text": "Changed the rotation rule to use text-based deadline detection instead of relying on an applied marker.",
        "variant": "body"
      },
      "children": []
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading_changes": {
      "type": "Heading",
      "props": {
        "text": "What Changed",
        "level": "h3"
      },
      "children": []
    },
    "text_file": {
      "type": "Text",
      "props": {
        "text": "Modified: skills/memory-flush/SKILL.md",
        "variant": "body"
      },
      "children": []
    },
    "text_rule_details": {
      "type": "Text",
      "props": {
        "text": "Replaced \"NOT CLEARED (deadline passed)\" marker requirement with text-based deadline detection. The rule now instructs the flush to find dates embedded in entry text and check for absence of \"CLEARED\" to determine removal eligibility.",
        "variant": "body"
      },
      "children": []
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "heading_impact": {
      "type": "Heading",
      "props": {
        "text": "Impact",
        "level": "h3"
      },
      "children": []
    },
    "text_impact_1": {
      "type": "Text",
      "props": {
        "text": "Prevents unbounded growth of Active Targets with expired hyperstitions.",
        "variant": "body"
      },
      "children": []
    },
    "text_impact_2": {
      "type": "Text",
      "props": {
        "text": "The 6 Sep 15 entries (plus future expired entries) will now be reliably cleaned up once 14 days have passed.",
        "variant": "body"
      },
      "children": []
    },
