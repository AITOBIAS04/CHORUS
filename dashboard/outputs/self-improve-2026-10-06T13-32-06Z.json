    },
    "change_file": {
      "type": "Text",
      "props": {
        "text": "skills/fetch-tweets/SKILL.md:",
        "variant": "lead"
      }
    },
    "change_desc": {
      "type": "Text",
      "props": {
        "text": "Added \"Compact log format during silence\" instruction — when consecutive_empty >= 7, log dedup summaries as counts instead of individual URLs. Full URL logging preserved during active periods for dedup verification.",
        "variant": "body"
      }
