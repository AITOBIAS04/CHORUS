    "badge_no_missing": {
      "type": "Badge",
      "props": {
        "text": "No missing skills",
        "variant": "default"
      }
    },
    "badge_no_failures": {
      "type": "Badge",
      "props": {
        "text": "No systemic failures",
        "variant": "default"
      }
    }
